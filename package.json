{
  "name": "@oheco/dsh-open-sessions",
  "version": "0.1.0",
  "description": "Open-session list above the sidebar workspaces: keep opened sessions loaded, switch instantly and close them like tabs.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/oheco/dsh-open-sessions.git" },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md", "LICENSE"],
  "scripts": {
    "check": "node --check index.js && node --check client.js"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
